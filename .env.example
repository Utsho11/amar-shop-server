# ==============================================================================
# Amar Shop Server - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual credentials
# ==============================================================================

# Application Port & Mode
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection
# Note: Use your primary database pooler URL with ?sslmode=require (avoid shadow DB)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secrets (Generate secure 256-bit random strings)
ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters
REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters
ACCESS_SECRET_EXPIRE=1d
REFRESH_SECRET_EXPIRE=30d
RESET_PASS_SECRET=your_jwt_password_reset_secret_key
RESET_PASS_SECRET_EXPIRE_IN=10m
RESET_PASS_LINK=http://localhost:5173/reset-password

# Mail Delivery Service (Gmail SMTP App Password)
SENDER_EMAIL=no-reply@amarshop.com
SENDER_APP_PASS=your_16_char_google_app_password

# Initial Root Administrative Provisioning
ADMIN_EMAIL=admin@amarshop.com
ADMIN_PASS=Admin@StrongSecurePass123

# Cloudinary Asset Cloud Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SSLCommerz Payment Gateway (Sandbox / Live)
STORE_ID=your_sslcommerz_store_id
STORE_PASSWD=your_sslcommerz_store_password
SIGNATURE_KEY=your_sslcommerz_signature_key
PAYMENT_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SEARCH_URL=https://sandbox.sslcommerz.com/validator/api/merchantTransIDvalidationAPI.php

# Service Networking & CORS
SERVER_BASE_URL=http://localhost:5000
CLIENT_BASE_URL=http://localhost:5173
